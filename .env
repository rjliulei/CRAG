# SiliconFlow（硅基流动）— 勿提交到 Git
SILICONFLOW_API_KEY=sk-fjdpeggtfudwyvjvejjgzplycheeawzjytnwfmnpyzethtmb
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 裁判走 DeepSeek 时（local_evaluation_deepseek.py / EVALUATION_MODEL_NAME 含 deepseek）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EVALUATION_MODEL_NAME=deepseek-ai/DeepSeek-V3.2

# 若仍用官方 OpenAI GPT 裁判，可另设：
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 评测数据集 DATASET_PATH（取消注释其中一行作为当前使用；路径相对仓库根目录或绝对路径）
# ---------------------------------------------------------------------------
# 仓库自带小样本（约 10 条）：冒烟、确认环境/依赖是否通
# DATASET_PATH=example_data/dev_data.jsonl.bz2

# 从前 100 条截取：快速冒烟，样本偏文件开头，代表性一般
# DATASET_PATH=example_data/dev_subset_100_head.jsonl.bz2

# 随机 100 条（seed=42）：中等规模试跑，分布更均衡
# DATASET_PATH=example_data/dev_subset_100_random.jsonl.bz2

# Step 4 典型子集 200 条（当前使用）
DATASET_PATH=example_data/dev_subset_200_typical_20260825_222321.jsonl.bz2

# Task1/2 全量开发集 v4（约 2706 条，~706MB）：正式本地评测时改回
# DATASET_PATH=/root/autodl-tmp/20260820-crag/crag_task_1_and_2_dev_v4.jsonl.bz2

# Task1/2 全量开发集 v5（约 2706 条，~706MB）：同任务更新版；与 v4 二选一，对比分数时勿混用
# DATASET_PATH=/root/autodl-tmp/20260820-crag/crag_task_1_and_2_dev_v5.jsonl.bz2

# Task3 为分卷 tar.bz2（每问最多 50 页 HTML），需先 cat 合并再解压，不能直接当 DATASET_PATH：
#   /root/autodl-tmp/20260820-crag/crag_task_3_dev_v4.tar.bz2.part*
#   /root/autodl-tmp/20260820-crag/crag_task_3_dev_v5.tar.bz2.part*

# ---------------------------------------------------------------------------
# Step 4 拒答开关（models/rag_llama_baseline.py · RAGModel）
# v1: RAG_ABSTAIN_ENABLED=1 → max 查询–句余弦 < τ 则 I don't know
# v2: RAG_ABSTAIN_V2_ENABLED=1 → 生成后 max 答案–句余弦 < sim 则改拒答
# ---------------------------------------------------------------------------
RAG_ABSTAIN_ENABLED=0
RAG_ABSTAIN_MIN_MAX_SCORE=0.40
RAG_ABSTAIN_V2_ENABLED=1
RAG_ABSTAIN_ANSWER_MIN_SIM=0.25

# ---------------------------------------------------------------------------
# 实验名（可选）：裁判 API 落盘目录 api_responses/<EXPERIMENT_NAME>/
# 不设置则自动命名，如 eval_RAG_KG_Model_DeepSeek-V3-2_20260824_155105_crag_task_1_and_2_dev_v4
# ---------------------------------------------------------------------------
# EXPERIMENT_NAME=eval_ragkg_20260824_155105
